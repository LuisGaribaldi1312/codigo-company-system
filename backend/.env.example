# ==========================================
# Configuración de la Base de Datos
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codigo_company
DB_USER=postgres
DB_PASSWORD=

# ==========================================
# Configuración de Autenticación
# ==========================================
JWT_SECRET=tu_clave_secreta_jwt_muy_fuerte_aqui
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Configuración del Servidor
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Supabase (para almacenamiento de fotos)
# ==========================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==========================================
# Configuración de Email (opcional)
# ==========================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=